# Root level .gitignore for Vidya Shakthi Project

# Environment files (project-wide)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local

# Logs (project-wide)
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Dependencies (project-wide)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Build outputs (project-wide)
dist/
build/
out/
lib/
*.tsbuildinfo

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Coverage directory used by tools like istanbul
coverage/
*.lcov

# nyc test coverage
.nyc_output

# TypeScript cache
*.tsbuildinfo

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Optional stylelint cache
.stylelintcache

# Microbundle cache
.rpt2_cache/
.rts2_cache_cjs/
.rts2_cache_es/
.rts2_cache_umd/

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# Temporary folders
tmp/
temp/

# Editor directories and files
.vscode/
.idea/
*.swp
*.swo
*~

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Local Netlify folder
.netlify

# Sentry Config File
.sentryclirc

# Stores VSCode versions used for testing VSCode extensions
.vscode-test

# yarn v2
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz
.pnp.*

# Local development
.local
.cache

# Database
*.db
*.sqlite
*.sqlite3
data/
mongodb-data/

# Uploads
uploads/
public/uploads/
static/uploads/

# Test files
test-results/
coverage/
.nyc_output/

# Performance monitoring
.nyc_output/
coverage/

# Backup files
*.backup
*.bak
*.tmp

# Lock files (keep package-lock.json but ignore others)
yarn.lock
pnpm-lock.yaml

# IDE files
*.sublime-project
*.sublime-workspace
.vscode/settings.json
.vscode/launch.json
.vscode/extensions.json

# Local configuration overrides
config.local.js
config.local.json

# PM2 files
ecosystem.config.js
.pm2/

# SSL certificates
*.pem
*.key
*.crt
*.csr
ssl/

# JWT secrets and keys
jwt-secret.txt
private-key.pem
public-key.pem

# Backup and migration files
backups/
migrations/backup/

# Local development databases
mongodb/
postgres/
redis/

# Docker
.dockerignore
docker-compose.override.yml

# Kubernetes
k8s-secrets/
*.kubeconfig

# Monitoring and analytics
monitoring/
analytics/

# WebSocket specific
websocket-connections/
socket-sessions/
connection-logs/

# Signaling server specific
signaling-logs/
connection-pools/
session-data/

# Media files
media/
recordings/
audio/
video/

# Call recordings
call-recordings/
voice-messages/

# Project specific
documentation/generated/
scripts/output/
tools/cache/

# Archive files
*.zip
*.tar.gz
*.rar
*.7z

# Temporary project files
.project-temp/
.temp/
